{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "note-directory",
  // Not a secret; lets CI deploy with an API token alone
  "account_id": "cd0a3951ad319f256ebb0f3a2b44e9c2",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  // The repo root is the site; .assetsignore keeps dev files out
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Only sign-in runs code; every other request is a static file
    "run_worker_first": ["/auth/*"]
  },
  "vars": {
    "GOOGLE_CLIENT_ID": "355563554662-02psj7te5k9m01j8qefegce60ubghdjp.apps.googleusercontent.com"
  },
  // Secrets (wrangler secret put): GOOGLE_CLIENT_SECRET, COOKIE_KEY
  "routes": [{ "pattern": "note.directory", "custom_domain": true }],
  "workers_dev": true
}
